-- in.cue --
a: {foo: 1 @foo() @baz(1)} @test(eq, {foo: 1 @foo() @baz(1)})
b: {foo: 1 @bar() @foo()}  @test(eq, {foo: 1 @foo() @bar()})
c: a & b                   @test(eq, {foo: 1 @foo() @baz(1) @bar()})

e: a & {foo: 1 @foo(other)} @test(eq, {foo: 1 @foo(other) @foo() @baz(1)})
-- oracle/export.json --
{
    "a": {
        "foo": 1
    },
    "b": {
        "foo": 1
    },
    "c": {
        "foo": 1
    },
    "e": {
        "foo": 1
    }
}
