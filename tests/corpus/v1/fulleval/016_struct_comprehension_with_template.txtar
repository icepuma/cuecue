-- in.cue --
result: [for _, v in service {v}] @test(eq, [{
	name: *"foo" | string
	type: "service"
	port: *7080 | int
}, {
	port: 8000
	name: *"bar" | string
	type: "service"
}, {
	name: "foobar"
	type: "service"
	port: *7080 | int
}])

service: [Name=string]: {
	name: *Name | string
	type: "service"
	port: *7080 | int
}
service: foo: {} @test(eq, {
	name: *"foo" | string
	type: "service"
	port: *7080 | int
})
service: bar: {port: 8000} @test(eq, {
	port: 8000
	name: *"bar" | string
	type: "service"
})
service: baz: {name: "foobar"} @test(eq, {
	name: "foobar"
	type: "service"
	port: *7080 | int
})
-- oracle/export.json --
{
    "result": [
        {
            "name": "foo",
            "type": "service",
            "port": 7080
        },
        {
            "name": "bar",
            "type": "service",
            "port": 8000
        },
        {
            "name": "foobar",
            "type": "service",
            "port": 7080
        }
    ],
    "service": {
        "foo": {
            "name": "foo",
            "type": "service",
            "port": 7080
        },
        "bar": {
            "name": "bar",
            "type": "service",
            "port": 8000
        },
        "baz": {
            "name": "foobar",
            "type": "service",
            "port": 7080
        }
    }
}
