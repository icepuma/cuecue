#name: detectIncompleteYAML
#evalFull
-- in.cue --
package foobar

import yaml "encoding/yaml"

#Spec: {
	_vars: {something: string}
	data: {
		#foo: {
			use: _vars.something
		}
		baz:    yaml.Marshal(_vars.something) @test(err, code=incomplete, pos=[0:11])
		foobar: yaml.Marshal(#foo)            @test(err, code=incomplete, pos=[0:11, -6:21, -3:9])
	}
}
Val: #Spec & {
	_vars: something: "var-string"
} @test(eq, {
	_vars$foobar: something: "var-string"
	data: {
		#foo: use:    "var-string"
		baz:   "var-string\n"
		foobar: "use: var-string\n"
	}
})
-- oracle/export.json --
{
    "Val": {
        "data": {
            "baz": "var-string\n",
            "foobar": "use: var-string\n"
        }
    }
}
