-- in.cue --
res: [for x in a for y in x {y & {d: "b"}}]
res: [ a.b.c & {d: "b"}]

a: b: [C=string]: {d: string, s: "a" + d}
a: b: c: d: string
@test(eq, {
	res: [ {d: "b", s: "ab"} ]
	a: b: c: {
		d: string
		s: _|_ @test(err, code=incomplete, pos=[-2:34, -2:23, -1:13])
	}
})
-- oracle/error --
incomplete a.b.c.d
incomplete a.b.c.s
