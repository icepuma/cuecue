# This file tests disjunctions used as operands.
-- in.cue --
list:      *[1] | [2]      @test(eq, *[1] | [2])
condition: *true | false   @test(eq, *true | false)
num:       *1 | 2          @test(eq, *1 | 2)
object:    *{a: 1} | {a: 2} @test(eq, *{a: 1} | {a: 2})

forLoop: [
	for e in list {
		"count: \(e)"
	},
] @test(eq, ["count: 1"])

conditional: {
	if condition {
		a: 3
	}
	if num < 5 {
		b: 3
	}
	@test(eq, {a: 3, b: 3})
}

selector: {
	a: object.a
	@test(eq, {a: 1})
}

index: {
	a: list[0]
	@test(eq, {a: 1})
}

binOp: {
	a: num + 4
	@test(eq, {a: 5})
}

unaryOp: {
	a: -num
	@test(eq, {a: -1})
}
-- oracle/export.json --
{
    "list": [
        1
    ],
    "condition": true,
    "num": 1,
    "object": {
        "a": 1
    },
    "forLoop": [
        "count: 1"
    ],
    "conditional": {
        "a": 3,
        "b": 3
    },
    "selector": {
        "a": 1
    },
    "index": {
        "a": 1
    },
    "binOp": {
        "a": 5
    },
    "unaryOp": {
        "a": -1
    }
}
