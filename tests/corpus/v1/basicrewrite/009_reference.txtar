-- in.cue --
a: b @test(eq, 2)
b: 2
d: {
	d: 3
	e: d @test(eq, 3)
} @test(eq, {d: 3, e: 3})
e: {
	@test(eq, {
		e: {v: 1}
		f: {v: 1}
	})
	e: {
		v: 1
	}
	f: {
		v: e.v
	}
}
-- oracle/export.json --
{
    "a": 2,
    "b": 2,
    "d": {
        "d": 3,
        "e": 3
    },
    "e": {
        "e": {
            "v": 1
        },
        "f": {
            "v": 1
        }
    }
}
