-- in.cue --
bool1: "1+1=2:  \(true)" @test(eq, "1+1=2:  true")
bool1: "1+1=2:  \(true)"
bool2: "1+1=1:  \(false)" @test(eq, "1+1=1:  false")

// one replacement character
b1:      'a\xED\x95a'   @test(eq, 'a\xed\x95a')
bytes1s: "\(b1)"        @test(eq, "a\uFFFDa")
bytes1b: '\(b1)'        @test(eq, 'a\xed\x95a')

// two replacement characters
b2:      'a\x80\x95a'   @test(eq, 'a\x80\x95a')
bytes2s: "\(b2)" @test(eq, "a�a")
bytes2b: '\(b2)'        @test(eq, 'a\x80\x95a')

// preserve precision
n1: "\(1) \(2.00)"      @test(eq, "1 2.00")

// but normalize representation
n2: "\(1e2)"            @test(eq, "1E+2")
-- oracle/export.json --
{
    "bool1": "1+1=2:  true",
    "bool2": "1+1=1:  false",
    "b1": "Ye2VYQ==",
    "bytes1s": "a�a",
    "bytes1b": "Ye2VYQ==",
    "b2": "YYCVYQ==",
    "bytes2s": "a�a",
    "bytes2b": "YYCVYQ==",
    "n1": "1 2.00",
    "n2": "1E+2"
}
