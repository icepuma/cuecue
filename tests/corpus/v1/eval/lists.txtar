-- in.cue --
a: [...int]
a: [1, 2, 3, 5]
a: [1, 2, 3, d] @test(eq, [1, 2, 3, 5])

b: a[3] @test(eq, 5)
d: 5    @test(eq, 5)

c: [for x in [[1, 2]][0] {x + d}] @test(eq, [6, 7])
-- oracle/export.json --
{
    "a": [
        1,
        2,
        3,
        5
    ],
    "b": 5,
    "d": 5,
    "c": [
        6,
        7
    ]
}
