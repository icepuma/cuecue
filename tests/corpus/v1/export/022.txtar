raw: true
eval: true
noOpt: true
#inlinetest:exclude skip — tests export format, not evaluator semantics
-- in.cue --
{
	job: [Name=_]: {
		name:     Name
		replicas: uint | *1 @protobuf(10)
		command:  string
	}

	job: list: command: "ls"

	job: nginx: {
		command:  "nginx"
		replicas: 2
	}
}
-- oracle/export.json --
{
    "job": {
        "list": {
            "name": "list",
            "replicas": 1,
            "command": "ls"
        },
        "nginx": {
            "name": "nginx",
            "replicas": 2,
            "command": "nginx"
        }
    }
}
