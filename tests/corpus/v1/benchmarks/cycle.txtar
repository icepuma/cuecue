-- in.cue --
sameValues: SmustBeF: {
	T: string | F
	F: {
		x: T
		@test(eq, {x: string})
		@test(shareID=SF)
	}
	S: F @test(eq, {x: string}) @test(shareID=SF)
}

sameValues: CmustBeA: {
	A: {
		x: [ string | A ]
		@test(eq, {x: [string]})
		@test(shareID=CA)
	}
	C: A @test(eq, {x: [string]}) @test(shareID=CA)
}
