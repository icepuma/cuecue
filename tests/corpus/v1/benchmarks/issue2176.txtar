# Tests that a sliding-window computation over string characters (finding unique
# character combinations of a given length) evaluates efficiently. The nested
# let-bindings and list comprehensions triggered performance regressions between
# CUE versions.
# https://cuelang.org/issue/2176
-- in.cue --
import (
	"strings"
	"list"
)

#Datastream: {
	message: string
	message: strings.MinRunes(4)

	marker: {
		length: int
		position: {
			let characters = strings.Split(message, "")
			let unique_combinations = {
				// begin computation once we have more than x number of characters.
				for i, _ in characters if i >= length-1 {
					// this line is causing an increased evaluation time between cue versions.
					// vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
					let combination = list.Slice(characters, i-length+1, i+1)

					// last x number of characters are not unique.
					if list.UniqueItems(list.Slice(characters, i-length+1, i+1)) {
						"\(i+1)": combination
					}
				}
			}
			[for i, _ in unique_combinations {i}][0]
		}
	}
}

input_short: """
	mjqjpqmgbljsphdztnvjfqwrcgsmlb
	"""
input_long: """
	
	"""

input: *input_short | input_long

datastream: #Datastream & {message: input}

output: [string]: string
output: {
	"1": (datastream & {marker: length: 4}).marker.position
	"2": (datastream & {marker: length: 14}).marker.position
} @test(eq, {"1": {"7"}, "2": {"19"}})
// NOTE: output contains lots of expanded lets. Use @test(debug) to view.

@test(eq,at=datastream, {
	message: *"mjqjpqmgbljsphdztnvjfqwrcgsmlb" | ""
	marker: {length: int, position: {_|_}}
})

-- oracle/error --
incomplete datastream.marker.length
incomplete datastream.marker.position.unique_combinations
