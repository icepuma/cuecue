#inlinetest:exclude CUE source contains compile-time errors (invalid operands to *)
# which prevent the inline runner from compiling the source.
#name: list arithmetic
#evalPartial
-- in.cue --
l3: <=2 * []
l4: <=2 * [int]
l5: <=2 * (int * [int])
b:  <=5 * [int]
b: [1, 2, ...]
c: (>=3 & <=5) * [int]
c: [1, 2, ...]
d: >=2 * [int]
d: [1, 2, ...]
-- oracle/error --
incomplete b
incomplete d
incomplete l3
incomplete l4
incomplete l5
