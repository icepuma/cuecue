# Cycle errors report no source position information, making it impossible
# to locate the offending code.
# https://cuelang.org/issue/3118
-- in.cue --
#TimeSpan: {
	start:    float
	duration: float
	end:      float

	start:    end - duration
	duration: end - start
	end:      start + duration

	start: <=end
}

examples: [string]: #TimeSpan

examples: eg1: {
    start: 10.0
    duration: 2.1
    @test(eq, {start: 10.0, duration: 2.1, end: 12.1})
}

examples: eg2: {
    start: 10.0
    @test(eq, {
	start: _|_    @test(err, code=incomplete, pos=[-15:12, -17:12, -13:12])
	duration: _|_ @test(err, code=incomplete, pos=[-14:12, -17:12, -13:12])
	end: _|_      @test(err, code=incomplete, pos=[-14:12, -17:12, -13:12])
})
}

examples: eg3: {
    end: 10.0
    @test(eq, {
	end: _|_      @test(err, code=incomplete, pos=[-22:12, -28:12, -24:12, -20:9])
	start: _|_    @test(err, code=incomplete, pos=[-23:12, -28:12, -24:12, -20:9])
	duration: _|_ @test(err, code=incomplete, pos=[-23:12, -28:12, -24:12, -20:9])
})
}
-- oracle/error --
incomplete examples.eg2.duration
incomplete examples.eg2.start
incomplete examples.eg3.duration
incomplete examples.eg3.end
