# evalv3 panics with nil pointer dereference on a reduced real-world CUE file
# involving `let` bindings and mutual references between definitions, whereas
# evalv2 handles it correctly.
# https://cuelang.org/issue/3527
-- in.cue --
package p

_taxPayer: self: {}

let sam = {taxPayer: _taxPayer}
assert: {
	invoke: sam
	invoke: _
	res: subject & {in: invoke}
}

subject: {
	in: #ReturnData
	_computed: (#computeF1040 & {"in": in})
}
#computeF1040: in:      #ReturnData
#ReturnData: taxPayer?: #TaxPayer
#TaxPayer: self?:       _

@test(eq, {
	_taxPayer$p: {self: {}}
	assert: {
		invoke: {taxPayer: {self: {}}}
		res: {
			in: {taxPayer: {self: {}}}
			_computed$p: {in: {taxPayer: {self: {}}}}
		}
	}
	subject: {
		in: {taxPayer?: {self?: _}}
		_computed$p: {in: {taxPayer?: {self?: _}}}
	}
	#computeF1040: {in: {taxPayer?: {self?: _}}}
	#ReturnData: {taxPayer?: {self?: _}}
	#TaxPayer: {self?: _}
})
-- oracle/export.json --
{
    "assert": {
        "invoke": {
            "taxPayer": {
                "self": {}
            }
        },
        "res": {
            "in": {
                "taxPayer": {
                    "self": {}
                }
            }
        }
    },
    "subject": {
        "in": {}
    }
}
